{
  "name": "abgabestellen-app",
  "version": "1.0.0",
  "description": "Multi-region open-source platform for food drop-off points (Abgabestellen & Soziale Einrichtungen)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --platform=node --target=node22 --packages=external --bundle --format=esm --outfile=dist/server/index.mjs && cp src/server/db/schema.sql dist/server/schema.sql",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "lucide-vue-next": "^0.469.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
