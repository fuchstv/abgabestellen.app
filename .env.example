# abgabestellen.app Environment Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# GCP & Firebase Configuration
GCP_PROJECT_ID=abgabestellen-app-prod
GCP_PROJECT_NUMBER=1087619962477
FIREBASE_PROJECT_ID=abgabestellen-app
GCP_REGION=europe-west3
GCS_LITESTREAM_BUCKET=wal-backup-abgabestellen-app

# Google Maps / Places API (Frontend Key)
# Allowed Referrers: https://abgabestellen.app/*, https://*.abgabestellen.app/*, http://localhost:*/*
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_frontend_api_key_here

# Database File Path
DATABASE_PATH=/data/abgabestellen.db

# HMAC Webhook Signing Secret (Shared with foodsharing.de / partners)
WEBHOOK_SHARED_SECRET=replace_with_strong_random_secret_hmac_256

# SMTP Configuration (Custom Domain)
SMTP_HOST=mail.abgabestellen.app
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@abgabestellen.app
SMTP_PASS=
SMTP_FROM="abgabestellen.app <notifications@abgabestellen.app>"

# CORS Origins
CORS_ALLOWED_ORIGINS=https://abgabestellen.app,https://foodsharing.de,http://localhost:3000,http://localhost:5173
